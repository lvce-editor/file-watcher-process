{
  "name": "@lvce-editor/file-watcher-process-monorepo",
  "version": "0.0.0-dev",
  "description": "File Watcher Process Monorepo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvce-editor/file-watcher-process.git"
  },
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.js",
    "build:watch": "npm exec --workspace=packages/build -- esbuild --format=esm --platform=node --bundle --external:electron --external:trash --external:ws --watch packages/file-watcher-process/src/fileWatcherProcessMain.ts --outfile=packages/file-watcher-process/dist/index.js",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "npm test --workspaces --if-present",
    "test-integration": "npm run test-integration --workspaces --if-present",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 130
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^17.5.0",
    "eslint": "^10.8.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "browserslist": "4.28.2"
  },
  "engines": {
    "node": ">=22"
  }
}
